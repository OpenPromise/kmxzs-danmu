# ============================================================
# kmxzs 反向代理（Caddy v2）
#
#   HTTPS 入口（新客户端 / 管理后台）: https://<IP>:18443
#   HTTP 过渡入口（老客户端 1.0.x）:  http://<IP>:18088
#
# 证书：先用 scripts/generate-selfsigned-cert.sh <IP> 生成，
#      挂载到 /certs/kmxzs-selfsigned.{crt,key}
#
# 管理 SPA：admin-web 构建产物（dist/）由 Caddy 静态托管在 /panel/*，
#          history 路由回退到 /panel/index.html；/api/* 继续反代到 FastAPI。
# ============================================================

:18443 {
	tls /certs/kmxzs-selfsigned.crt /certs/kmxzs-selfsigned.key
	encode gzip

	# /panel 补斜杠，避免 handle_path 匹配不到
	redir /panel /panel/ permanent

	# 管理 SPA：/panel/* 由 Caddy 托管静态产物，history 路由回退到 index.html
	handle_path /panel/* {
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}

	# 其余请求（/api/*、/files/*、/config、/zbpanel/*）代理到后端
	reverse_proxy kmxzs-card:18080 {
		header_up X-Forwarded-Proto https
	}
}

# 明文 HTTP 仅做老客户端过渡：/health、/config、/files/* 由后端放行，
# 其余路径后端会返回 403，推动老用户升级到 HTTPS 新客户端。
:18088 {
	reverse_proxy kmxzs-card:18080 {
		header_up X-Forwarded-Proto http
	}
}
