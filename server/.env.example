# 复制为 .env 后填写密钥：  cp .env.example .env
# 生成密钥：              openssl rand -hex 32
# 也可用：                bash deploy.sh   （自动生成）

# ---------- 必填（留空将无法启动生产 compose）----------
KMXZS_API_SECRET=

# ---------- 可选 ----------
# 宿主机对外端口（客户端连 http://服务器IP:端口）
KMXZS_HOST_PORT=18088

# 管理后台 Token：留空则首次启动自动生成，写入 volume /data/admin_token.txt
KMXZS_ADMIN_TOKEN=

# 后台浏览器登录（合作伙伴用这个，不要发给普通用户）
# 路径不要用 /admin，减少端口扫描命中
KMXZS_ADMIN_PATH=/zbpanel
# 密码留空则首次启动自动生成，写入 /data/admin_basic.txt
KMXZS_ADMIN_USER=zbxzs
KMXZS_ADMIN_PASSWORD=

# 每卡最多绑定设备数
KMXZS_MAX_DEVICES=1

# 用户解绑设备扣除的小时数
KMXZS_UNBIND_PENALTY_HOURS=12

# 登录限流：每 IP 在窗口内最多次数
KMXZS_LOGIN_RATE_LIMIT=10
KMXZS_LOGIN_RATE_WINDOW=900

# 桌面端一般不需要 CORS，保持空即可
KMXZS_CORS_ORIGINS=

# 仅当前面有可信反代时才设为 1（否则勿开，防伪造 IP 绕过限流）
KMXZS_TRUST_PROXY=0

# 客户端版本提示（后台也可改）
KMXZS_CLIENT_VERSION=1.0.0
KMXZS_MIN_CLIENT_VERSION=1.0.0
KMXZS_FORCE_UPDATE=0
KMXZS_DOWNLOAD_URL=
