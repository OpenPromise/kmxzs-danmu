# 复制为 .env 后填写密钥：  cp .env.example .env
# 生成密钥：              openssl rand -hex 32
# 也可用：                bash deploy.sh   （自动生成）

# ---------- 必填（留空将无法启动生产 compose）----------
KMXZS_API_SECRET=

# ---------- 可选 ----------
# 服务器公网 IP（用于生成自签证书，供 Caddy 与客户端绑定）
KMXZS_SERVER_IP=

# 对外端口：HTTP 过渡入口（老客户端 1.0.x）与 HTTPS 入口
KMXZS_HTTP_PORT=18088
KMXZS_HTTPS_PORT=18443

# 是否信任反代（生产 compose 默认 1；仅在可信反代后开启）
KMXZS_TRUST_PROXY=1
# 明文 HTTP 仅放行 /config、/files/*、/health（生产 compose 默认 1）
KMXZS_HTTP_TRANSITION=1

# 管理后台 Token：留空则首次启动自动生成，写入 volume /data/admin_token.txt
KMXZS_ADMIN_TOKEN=

# 后台浏览器登录（合作伙伴用这个，不要发给普通用户）
# 路径不要用 /admin，减少端口扫描命中
KMXZS_ADMIN_PATH=/zbpanel
# 密码留空则首次启动自动生成，写入 /data/admin_basic.txt
KMXZS_ADMIN_USER=zbxzs
KMXZS_ADMIN_PASSWORD=

# 阶段1：超管账号（首次启动自动创建；密码留空则自动生成到 /data/superadmin.txt）
KMXZS_SUPERADMIN_USER=superadmin
KMXZS_SUPERADMIN_PASSWORD=

# 阶段1：JWT 签名密钥（可留空，首次启动自动生成到 /data/jwt_secret.txt；重启不变）
KMXZS_JWT_SECRET=

# 每卡最多绑定设备数
KMXZS_MAX_DEVICES=1

# 用户解绑设备扣除的小时数
KMXZS_UNBIND_PENALTY_HOURS=12

# 登录限流：每 IP 在窗口内最多次数
KMXZS_LOGIN_RATE_LIMIT=10
KMXZS_LOGIN_RATE_WINDOW=900

# 桌面端一般不需要 CORS，保持空即可
KMXZS_CORS_ORIGINS=

# 客户端版本提示（后台也可改）
KMXZS_CLIENT_VERSION=1.0.0
KMXZS_MIN_CLIENT_VERSION=1.0.0
KMXZS_FORCE_UPDATE=0
KMXZS_DOWNLOAD_URL=
