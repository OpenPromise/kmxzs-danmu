# 复制为 secrets.ps1 后再打包（secrets.ps1 不要提交到 Git）
$apiBase = "https://你的服务器IP:18443"
$apiSecret = "与服务器 .env 中 KMXZS_API_SECRET 相同"

# 阶段3（必填，生产包）：
# 服务器自签证书 SHA-256 指纹（hex 或 base64）：
#   bash server/scripts/export-cert-fingerprint.sh server/certs/kmxzs-selfsigned.crt
$certSha256 = ""

# 安装包 Ed25519 公钥（base64）：
#   服务器启动日志或 cat /data/release_signing.pub 里的 base64 行
$updatePubkey = ""

$version = "1.0.12"
